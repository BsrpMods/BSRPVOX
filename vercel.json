{
  "functions": {
    "public_html/api/login.php":                   { "runtime": "vercel-php@0.7.2" },
    "public_html/api/logout.php":                  { "runtime": "vercel-php@0.7.2" },
    "public_html/api/verify.php":                  { "runtime": "vercel-php@0.7.2" },
    "public_html/api/activate.php":                { "runtime": "vercel-php@0.7.2" },
    "public_html/api/admin/login.php":             { "runtime": "vercel-php@0.7.2" },
    "public_html/api/admin/create-license.php":    { "runtime": "vercel-php@0.7.2" },
    "public_html/api/admin/list-licenses.php":     { "runtime": "vercel-php@0.7.2" },
    "public_html/api/admin/revoke-license.php":    { "runtime": "vercel-php@0.7.2" },
    "public_html/api/admin/reset-device.php":      { "runtime": "vercel-php@0.7.2" },
    "public_html/admin/ganti-admin.php":           { "runtime": "vercel-php@0.7.2" }
  },
  "rewrites": [
    { "source": "/api/admin/:path*", "destination": "/public_html/api/admin/:path*" },
    { "source": "/api/:path*",       "destination": "/public_html/api/:path*" },
    { "source": "/admin/ganti-admin.php", "destination": "/public_html/admin/ganti-admin.php" },
    { "source": "/admin",            "destination": "/public_html/admin/index.html" },
    { "source": "/admin/",           "destination": "/public_html/admin/index.html" }
  ]
}
